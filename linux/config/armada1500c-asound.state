			count 1
			range '0 - 255'
		}
	}
	control.40 {
		iface CARD
		name '3D Control - Limit Fall Level'
		value 149
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 255'
		}
	}
	control.41 {
		iface CARD
		name '3D Control - Limit Rise Speed'
		value 9
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 15'
		}
	}
	control.42 {
		iface CARD
		name '3D Control - Limit Fall Speed'
		value 4
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 15'
		}
