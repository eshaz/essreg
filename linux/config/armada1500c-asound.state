		name 'Capture Switch'
		value true
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.15 {
		iface MIXER
		name 'Record Monitor'
		value false
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.16 {
		iface MIXER
		name 'PCM Capture Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 0
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.17 {
		iface MIXER
		name 'Mic Capture Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 1050
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.18 {
		iface MIXER
		name 'Line Capture Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.19 {
		iface MIXER
		name 'FM Capture Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 1050
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.20 {
		iface MIXER
		name 'CD Capture Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.21 {
		iface MIXER
		name 'Aux Capture Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
