# SPDX-License-Identifier: GPL-2.0-or-later
#
# The Armada 1500c's mixer under snd-es1869, as alsactl stores it: the
# laptop's saved state of snd-es18xx restored onto the driver's controls,
# Audio 2's volume (PCM, index 0) at 0 dB, and the new controls at their
# defaults, the DAC stages off among them. It takes the place of the
# state.ES1869 block in /var/lib/alsa/asound.state.
#
# (c) 2026 Ethan Halsall <ethan.s.halsall@gmail.com>

state.ES1869 {
	control.1 {
		iface MIXER
		name 'Master Playback Volume'
		value.0 63
		value.1 63
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 63'
			dbmin -4725
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.2 {
		iface MIXER
		name 'Master Playback Switch'
		value.0 true
		value.1 true
		comment {
			access 'read write'
			type BOOLEAN
			count 2
		}
	}
	control.3 {
		iface MIXER
		name 'PCM Playback Volume'
		value.0 15
		value.1 15
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.4 {
		iface MIXER
		name 'PCM Playback Volume'
		index 1
		value.0 15
		value.1 15
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 150
			dbvalue.0 150
			dbvalue.1 150
		}
	}
	control.5 {
		iface MIXER
		name 'FM Playback Volume'
		value.0 5
		value.1 5
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 1050
			dbvalue.0 -900
			dbvalue.1 -900
		}
	}
	control.6 {
		iface MIXER
		name 'Line Playback Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.7 {
		iface MIXER
		name 'CD Playback Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.8 {
		iface MIXER
		name 'Aux Playback Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.9 {
		iface MIXER
		name 'Mic Playback Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 1050
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.10 {
		iface MIXER
		name 'Mono Playback Volume'
		value.0 0
		value.1 0
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -9999999
			dbmax 300
			dbvalue.0 -9999999
			dbvalue.1 -9999999
		}
	}
	control.11 {
		iface MIXER
		name 'Beep Playback Volume'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 7'
			dbmin -9999999
			dbmax -600
			dbvalue.0 -9999999
		}
	}
	control.12 {
		iface MIXER
		name 'Capture Source'
		value Mic
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 Mic
			item.1 'Mic Master'
			item.2 CD
			item.3 AOUT
			item.4 Mic1
			item.5 Mix
			item.6 Line
			item.7 Master
		}
	}
	control.13 {
		iface MIXER
		name 'Capture Volume'
		value.0 3
		value.1 3
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -600
			dbmax 1650
			dbvalue.0 -150
			dbvalue.1 -150
