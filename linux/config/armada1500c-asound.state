	}
	control.29 {
		iface CARD
		name 'Audio 2 Own Clock Switch'
		value true
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.30 {
		iface CARD
		name 'Audio 2 To FM Playback Switch'
		value false
		comment {
