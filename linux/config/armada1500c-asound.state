		name '3D Control - Limit Fixed Level'
		value 128
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 255'
		}
	}
	control.44 {
		iface MIXER
		name 'Hardware Master Volume Split'
		value false
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.45 {
		iface CARD
		name 'Hardware Volume Mode'
		value Two-wire
		comment {
