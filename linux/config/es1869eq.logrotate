# SPDX-License-Identifier: GPL-3.0-or-later
#
# es1869eq's log, a few lines a minute while the music plays, and what it
# says on stderr: a week to a file and four kept. es1869scope keeps both
# open, so they are copied and cut in place.
#
# Install as /etc/logrotate.d/es1869eq (make install-services does).
#
# (c) 2026 Ethan Halsall <ethan.s.halsall@gmail.com>

/var/log/es1869eq.log /var/log/es1869eq.err {
	weekly
	rotate 4
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
}
