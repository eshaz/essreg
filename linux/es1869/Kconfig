	int "a1_settle_mode"
	range 0 1
	default 0
	help
	  0 a timer unmasks the channel, 1 the start waits for it. The
	  module parameter a1_settle_mode sets it at load and at
	  runtime, through
	  /sys/module/snd_es1869/parameters/a1_settle_mode.

config SND_ES1869_DEFAULT_A1C_SETTLE_MS
	int "a1c_settle_ms"
	range 0 1000
	default 200
	help
	  How long a recording waits for the ADC's input to settle after
	  the codec turns to it (ms); 0 starts at once, as ESS's drivers
	  do, and the first 100 ms then carry the input's offset
