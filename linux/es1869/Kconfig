config SND_ES1869_DEFAULT_BEEP_VOLUME
	int "beep_volume"
	range 0 7
	default 0
	help
	  The PC speaker (3Ch bits 2:0), 7 = -6 dB, 0 mutes it; the
	  board mixes it in after the master, so with beep_follow this
	  is its level at full master. The ALSA control "Beep Playback
	  Volume". The module parameter beep_volume sets it at load and
	  at runtime, through
	  /sys/module/snd_es1869/parameters/beep_volume.

config SND_ES1869_DEFAULT_BEEP_FOLLOW
	int "beep_follow"
	range 0 1
	default 1
	help
	  3Ch scaled by the master and 0 while it is muted, as ESS's
	  ES1869.DRV does it; 0 keeps the two apart. The ALSA control
	  "Beep Follows Master Playback Switch". The module parameter
	  beep_follow sets it at load and at runtime, through
	  /sys/module/snd_es1869/parameters/beep_follow.

