# The ES1869 driver. The defaults menu is generated by tools/es1869set.py
# from settings.def: change the rows there and run it again.

config SND_ES1869
	tristate "ESS ES1869 AudioDrive, every feature"
	depends on ISA_DMA_API
	select SND_OPL3_LIB
	select SND_MPU401_UART
	select SND_PCM
	select SND_HWDEP
	select SND_SEQ_DEVICE if SND_SEQUENCER != n
	help
	  Say Y or M for the ESS ES1869 AudioDrive with every feature of
	  the chip: both DACs (Audio 2 on a 16-bit DMA channel too), full
	  duplex, every rate of its clocks, the record mixer, the 3-D
	  effect, the DAC stages, the hardware volume buttons, the FM
	  recorded digitally, OPL3 and native ESFM synthesis, and the
	  MPU-401. Each setting is a module parameter that can be written
	  at runtime and, where it is chip state, an ALSA control.

	  It takes the same devices as snd-es18xx, so blacklist that one.

	  To compile this driver as a module, choose M here: the module
	  will be called snd-es1869.

config SND_ES1869_ESFM
	tristate "ES1869 native ESFM General MIDI synthesizer"
	depends on SND_ES1869 && SND_SEQUENCER
	default SND_ES1869
	help
	  A sequencer synthesizer on the ES1869's FM in its native ESFM
	  mode, playing General MIDI as ESS's fixed ESFM.DRV does, with a
	  bank loaded as firmware (es1869/esfm-gm.bin). The module will be
	  called snd-es1869-esfm.

menu "ES1869 default settings"
	depends on SND_ES1869

config SND_ES1869_DEFAULT_MASTER_VOLUME
	int "master_volume"
	range 0 63
	default 54
	help
	  Master volume (60h/62h bits 5:0), 63 = 0 dB, 0.75 dB a step.
	  The ALSA control "Master Playback Volume". The module
	  parameter master_volume sets it at load and at runtime,
	  through /sys/module/snd_es1869/parameters/master_volume.

