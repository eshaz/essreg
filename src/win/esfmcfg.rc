#include <windows.h>
#include "esfmcfg.h"

/* DS_3DLOOK (Windows 4.0) for the 3-D look that Windows 95 gives the boxes
   of 32-bit programs */
IDD_BANKS DIALOG 30, 30, 248, 122
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | 0x0004L
CAPTION "MIDI patch banks"
FONT 8, "MS Sans Serif"
BEGIN
  LTEXT "&ESFM Synthesis plays:", IDC_ESFM_LABEL, 8, 8, 172, 8
  COMBOBOX IDC_ESFM, 8, 19, 174, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "&Browse...", IDC_ESFM_BROWSE, 188, 18, 52, 14
  LTEXT "&OPL3 FM Synthesis plays:", IDC_OPL3_LABEL, 8, 40, 172, 8
  COMBOBOX IDC_OPL3, 8, 51, 174, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "B&rowse...", IDC_OPL3_BROWSE, 188, 50, 52, 14
  LTEXT "", IDC_NOTE, 8, 72, 232, 26
  DEFPUSHBUTTON "OK", IDOK, 132, 102, 52, 14
  PUSHBUTTON "Cancel", IDCANCEL, 188, 102, 52, 14
END
