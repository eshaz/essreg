#include <windows.h>
#include <ver.h>

#ifndef DS_3DLOOK
#define DS_3DLOOK 0x0004L
#endif

ESSWCHK ICON "essctl.ico"

ESSWCHK DIALOG 0, 0, 240, 84
STYLE WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | DS_3DLOOK
CAPTION "ES1869 Windows checks"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "", 101, 6, 6, 228, 9, SS_NOPREFIX
    LTEXT "", 102, 6, 18, 228, 9, SS_NOPREFIX
    LTEXT "", 103, 6, 30, 228, 9, SS_NOPREFIX
    LTEXT "", 104, 6, 42, 228, 9, SS_NOPREFIX
    /* no default button: Enter doesn't stop the checks by accident */
    PUSHBUTTON "&Stop", 105, 130, 64, 50, 14
    PUSHBUTTON "Close", 106, 184, 64, 50, 14
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS VOS_DOS_WINDOWS16
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", "ES1869 Windows checks\0"
            VALUE "FileVersion", "1.0\0"
            VALUE "InternalName", "ESSWCHK\0"
            VALUE "LegalCopyright", "(c) 2026 Ethan Halsall, GPL version 3\0"
            VALUE "OriginalFilename", "ESSWCHK.EXE\0"
            VALUE "ProductName", "essreg\0"
            VALUE "ProductVersion", "1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
