# Builds sb16test.exe, which checks the Sound Blaster 16 that DOS games
# find and writes a report (DOS, small model).
#
# Notes:
#
# No stack checks, because the interrupt handler runs on whatever stack it
# interrupts. piix4.obj is essreg.mk1's.
#
# (c) 2026 Ethan Halsall <ethan.s.halsall@gmail.com>
#
# Licensed under GPL Version 3.0

SB16T_FLAGS=-5 -osbhl+kp -fpi87 -s

sb16t.obj : src\sb16t.c .AUTODEPEND
 *wcc src\sb16t.c -i="$(%watcom)/h" $(SB16T_FLAGS) -w4 -e10 -d1 -bt=dos -fo=.obj -ms

sbtsound.obj : src\sbtsound.c .AUTODEPEND
 *wcc src\sbtsound.c -i="$(%watcom)/h" $(SB16T_FLAGS) -w4 -e10 -d1 -bt=dos -fo=.obj -ms

tears.obj : src\tears.c .AUTODEPEND
 *wcc src\tears.c -i="$(%watcom)/h" $(SB16T_FLAGS) -w4 -e10 -d1 -bt=dos -fo=.obj -ms

dosplat.obj : src\dosplat.c .AUTODEPEND
 *wcc src\dosplat.c -i="$(%watcom)/h" $(SB16T_FLAGS) -w4 -e10 -d1 -bt=dos -fo=.obj -ms

sb16test.obj : src\sb16test.c .AUTODEPEND
 *wcc src\sb16test.c -i="$(%watcom)/h" $(SB16T_FLAGS) -w4 -e10 -d1 -bt=dos -fo=.obj -ms

sb16test.exe : sb16t.obj sbtsound.obj tears.obj dosplat.obj sb16test.obj piix4.obj .AUTODEPEND
 @%write sb16test.lk1 FIL sb16test.obj,sb16t.obj,sbtsound.obj,tears.obj,dosplat.obj,piix4.obj
 @%append sb16test.lk1
 *wlink name sb16test sys dos op m libf cstart_t op maxe=10 op q op DOSSEG op STACK=4096 op el sort @sb16test.lk1
